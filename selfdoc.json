  "versions": [
    {
      "version": "0.15.3"
    }
  ],
  "locales": [
    {
      "code": "en",
      "label": "English",
      "default": true
    }
  ],
  "directives": {
    "table-events": ".strictmetadata/docs/_directives/event_catalog.py"
  },
  "gen": {
