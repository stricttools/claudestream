      "outputs": [
        "README.md"
      ]
    }
  ],
  "topology": {
    "slug": "claudestream",
    "docs_base": "https://smmh.dev",
    "posts_base": "https://blog.smmh.dev"
  },
  "assembly": {
    "repo": "smm-h/selfdoc-cache"
  },
  "search_engine": "pagefind",
  "author": {
    "name": "SMMH",
    "url": "https://smmh.dev",
    "same_as": [
      "https://github.com/smm-h"
    ]
  }
